#!/usr/bin/env bash

source cu.errors_lib.bash > /dev/null || { echo "Failed to source cu.errors_lib.bash" >&2; exit 1; }
source _cu.vars.configs > /dev/null || cu.errors.die $CU_ERROR "Faied to source _cu.vars.configs"


parsed=$(pflags parse --name cu.vars ---- \
  -s d -l delete -t string --default '' -h 'Delete var entry' -- \
  -l envs -t string --default '' -h 'Comma-separated var names to print formated as shell variables'  ---- "$@") || exit

eval set -- "$parsed"

while [[ $# -gt 0 ]]; do
  case $1 in
    --help)
      printf '%s' "$2"
      exit 0
      ;;
    --delete)
      FLAGS_delete="$2"
      shift 2
      ;;
    --envs)
      FLAGS_envs="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
  esac
done

user="$(whoami)"
namespace="${NAMESPACE_PREFIX}_${user}"

function check_unknown_args() {
  [[ $# -gt 0 ]] && cu.errors.die_usage "Unknown args $(cu.strings.quoted "$@")"
}

op=""
if [[ -n "$FLAGS_delete" && -n "$FLAGS_envs" ]]; then
  cu.errors.die_usage "--delete and --envs can not be used together"
elif [[ -n "$FLAGS_delete" ]]; then
  check_unknown_args "$@"
  _cu.persistent_kv delete "$namespace" "$FLAGS_delete"
elif [[ -n "$FLAGS_envs" ]]; then
  check_unknown_args "$@"
  _cu.persistent_kv concat "$namespace" "$FLAGS_envs" shellvars
elif [[ -z "$FLAGS_delete" && -z "$FLAGS_envs" ]]; then
  if [[ $# -eq 0 ]]; then
    _cu.persistent_kv list "$namespace"
  elif [[ $# -eq 1 ]]; then
    _cu.persistent_kv get "$namespace" "$1"
  elif [[ $# -eq 2 ]]; then
    if [[ "$2" == "-" ]]; then
      _cu.persistent_kv set_overwrite "$namespace" "$1"
    else
      printf "%s" "$2" | _cu.persistent_kv set_overwrite "$namespace" "$1"
    fi
  else
    cu.errors.die_usage "Unknown args $(cu.strings.quoted "${@:3}")"
  fi
else
  cu.errors.die $CU_ERROR "Something went wrong"
fi
