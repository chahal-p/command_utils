#!/usr/bin/env python3
import os
import sys
import subprocess

PROG_NAME = os.path.basename(__file__)

USAGE='''
Usage: {PROG_NAME} <command> [args...]
  <command>: The command to run on each line of the input from stdin
  Captured line is accessible with {}

Example:  
  cat file.txt | {PROG_NAME} echo '{}'
  Above command will print each line of file.txt
'''

def execute(command: list[str], line:str):
  exit_code = 1
  for i in range(0, len(command)):
    command[i] = command[i].replace('{}', line)
  try:
    result = subprocess.run(command, preexec_fn=os.setsid, text=True, capture_output=True)
    exit_code = result.returncode
    sys.stderr.write(result.stderr)
    sys.stderr.flush()
    if result.stdout is not None:
      sys.stdout.write(result.stdout if result.stdout.endswith('\n') else result.stdout + '\n')
    sys.stdout.flush()
  except KeyboardInterrupt:
    os.killpg(os.getpgid(result.pid), signal.SIGKILL)
    exit_code = 130
  except Exception as e:
    sys.stderr.write(f"Error: {e}\n")
    exit_code = 1
  return exit_code

def main():
  if len(sys.argv) < 2:
    sys.stderr.write(USAGE.replace('{PROG_NAME}', PROG_NAME))
    sys.exit(2)
  exit_code = None
  for line in sys.stdin.readlines():
    ret = execute(sys.argv[1:], line.rstrip('\n'))
    if exit_code is None or exit_code != 0:
      exit_code = ret
  sys.exit(exit_code)

if __name__ == "__main__":
  main()
