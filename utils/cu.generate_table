#!/usr/bin/env python3

import sys
import argparse
from tabulate import tabulate

cmd = sys.argv[0].split("/")[-1]

usage = "{} [-h] [-c ] -- <header1> <header2> ... -- <row1_col1> <row1_col2> ... -- <row2_col1> <row2_col2> ...".format(cmd)

args = sys.argv[1:]
internal_args = []
table = []
start_recording = False
header_done = False
headers = []
rows = []
row = []
rows.append(row)
max_col_count = 0
for arg in args:
  if not start_recording and arg == "--":
    start_recording = True
    continue
  if start_recording:
    if not header_done:
      if arg == "--":
        header_done = True
      else:
        headers.append(arg)
        max_col_count = max(max_col_count, len(headers))
    else:
      if arg == "--":
        row = []
        rows.append(row)
      else:
        row.append(arg)
        max_col_count = max(max_col_count, len(row))
  else:
    internal_args.append(arg)

parser = argparse.ArgumentParser(description="Generate a table", usage=usage)
parser.add_argument("-c", "--maxcolwidths", metavar="", type=int, default=None, help="Maximum column widths")
parsed_args = parser.parse_args(internal_args)
maxcolwidths = parsed_args.maxcolwidths

if not start_recording:
  print(usage)
  sys.exit(1)

if len(headers) > 0:
  headers = headers + ["" for _ in range(max_col_count - len(headers))]

for row in rows:
  row.extend(["" for _ in range(max_col_count - len(row))])
print(tabulate(rows, headers=headers, tablefmt="grid", maxcolwidths=maxcolwidths))
