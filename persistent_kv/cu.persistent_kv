#!/usr/bin/env bash

function usage() {
  cat << EOF
Usage: $(basename "$0") [-h] <SUBCOMMAND>

Subcommands:
  list
  get
  set
  delete
  etag
  chmod
  chown
  configure

Options:
  -h, --help        Show this help message and exit
EOF
}

first_arg="$1"
shift || true

case "$first_arg" in
  -h|--help)
    usage
    exit 0
    ;;
  list)
    exec -a "$(basename "$0") list" _cu.persistent_kv.list "$@"
    ;;
  get)
    exec -a "$(basename "$0") get" _cu.persistent_kv.get "$@"
    ;;
  set)
    exec -a "$(basename "$0") set" _cu.persistent_kv.set "$@"
    ;;
  delete)
    exec -a "$(basename "$0") delete" _cu.persistent_kv.delete "$@"
    ;;
  etag)
    exec -a "$(basename "$0") etag" _cu.persistent_kv.etag "$@"
    ;;
  chmod)
    exec -a "$(basename "$0") chmod" _cu.persistent_kv.chmod "$@"
    ;;
  chown)
    exec -a "$(basename "$0") chown" _cu.persistent_kv.chown "$@"
    ;;
  configure)
    exec -a "$(basename "$0") configure" _cu.persistent_kv.configure "$@"
    ;;
  *)
    echo "Unrecognized arguments: $arg" >&2
    exit 2
    ;;
esac
