#!/usr/bin/env bash

source cu.errors_lib.bash || exit

# Recommended permissions on storage directory is 1777
parsed_args=$(pflags parse --name "$(basename "${0}")" ---- \
  -s e -l editor -t string --default vim -h "Editor to use to edit file" -- \
  -s p -l print_path -t bool -h "Prints the path of config bash file" ---- "$@") || exit

eval set -- "${parsed_args[@]}"

while [[ $# -gt 0 ]]; do
  [[ "$1" == "--" ]] && { shift; break; }
  case $1 in
    --help)
      printf '%s' "$2"
      exit 0
      ;;
    *)
      arg_name="${1#-}"
      arg_name="${arg_name#-}"
      eval "FLAGS_${arg_name}='${2//\'/\'\\\'\'}'"
      shift 2
      ;;
  esac
done

config_path="$(which _cu.persistent_kv.configs)"

if [[ "$FLAGS_print_path" == "true" ]]; then
  echo "$config_path"
else
  [ -w "$config_path" ] || cu.errors.die "$CU_ERROR_PERMISSION_DENIED" "$(whoami) do not have write permission on file: $config_path"
  "$FLAGS_editor" "$config_path"
fi
