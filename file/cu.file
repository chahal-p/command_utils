#!/usr/bin/env bash

function usage() {
  cat <<EOF
Usage: $(basename "${0}") <absolute_file_path> <operation> [args...]

Operations are executed with exclusive lock on file path.

Operations:
  get
  get_without_lock
  set [<etag>]
  set_overwrite [<etag>]
  delete
  chmod <mode>
  chown <owner_group>

Details:
  etag              : sha256 of existing value (for new entry set it as empty string hash: \`sha256sum < <("")\`)
  set               : stdin is used as the value
  set_overwrite     : stdin is used as the value
  owner_group       : value format is <user>[:<group>]
EOF
}

[[ "$1" == "--help" || "$1" == "-h" ]] && { usage; exit 0; }

set -eo pipefail

source cu.errors_lib.bash || exit


FILE_PATH="$1"
OPERATION="$2"

shift 2 || true

[ -n "$FILE_PATH" ] || cu.errors.die "File path can not empty"

[[ "$FILE_PATH" == /* ]] || cu.errors.die "File path should be absolute"

##### Lock file #####
if [[ "$OPERATION" != "get_without_lock" ]]; then
  LOCK_DIR="/tmp/cu_files_locks"

  [[ -d "${LOCK_DIR}" ]] || mkdir -m 777 -p "${LOCK_DIR}" || cu.errors.die "Failed to create lock directory ${LOCK_DIR}"

  FILE_LOCK_PATH="$LOCK_DIR/$(cu.sha256sum "$FILE_PATH").lock" || cu.errors.die "Failed to create lockfile for $FILE_PATH"

  (umask 000 && touch "${FILE_LOCK_PATH}") || cu.errors.die $CU_ERROR "Failed to create lock file"

  lock_cmd="flock"
  cu.is_macos && lock_cmd="lockf"

  exec 200<"${FILE_LOCK_PATH}"
  $lock_cmd 200
fi
#####################

function get() {
  [ -r "${FILE_PATH}" ] || {
    [ -f "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_NOT_FOUND "Not found: $FILE_PATH does not exist"
    cu.errors.die $CU_ERROR_PERMISSION_DENIED "Permission denied: $FILE_PATH is not readable"
  }
  cat "${FILE_PATH}" || cu.errors.die $CU_ERROR "Failed to read file $FILE_PATH"
}

function set() {
  overwrite="${1}"
  etag="${2}"
  if [ -f "${FILE_PATH}" ]; then
    [ "${overwrite}" != "true" ] && cu.errors.die $CU_ERROR_ALREADY_EXISTS "Already exist: $FILE_PATH already exists"
  else
    (umask 137 && touch "${FILE_PATH}") || cu.errors.die $CU_ERROR "Failed to create file $FILE_PATH"
  fi
  [ -w "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_PERMISSION_DENIED "Permission denied: ${FILE_PATH} is not writable"
  if [[ -n "${etag}" ]]; then
    [ -r "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_PERMISSION_DENIED "Permission denied: ${FILE_PATH} is not readable, etag can not be matched."
    cat "${FILE_PATH}" 2>/dev/null | cu.sha256sum | grep -q "^${etag}$" || cu.errors.die $CU_ERROR_ETAG_MISMATCH "Etag mismatch for $FILE_PATH"
  fi
  cat - > "${FILE_PATH}" || cu.errors.die $CU_ERROR "Failed to set value to file $FILE_PATH"
}

function delete() {
  [ -f "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_NOT_FOUND "${FILE_PATH} is not found"
  [ -w "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_PERMISSION_DENIED "Permission denied: ${FILE_PATH} is not deletable"
  rm "${FILE_PATH}" > /dev/null 2>&1 || cu.errors.die $CU_ERROR "Failed to delete file ${FILE_PATH}"
}

function chmod() {
  mode="$1"
  [ -f "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_NOT_FOUND "$FILE_PATH does not found"
  chmod "${mode}" "${FILE_PATH}" || cu.errors.die $CU_ERROR "Failed to set mode on file $FILE_PATH"
}

function chown() {
  owner_group="${1}"
  [ -f "${FILE_PATH}" ] || cu.errors.die $CU_ERROR_NOT_FOUND "$FILE_PATH does not found"
  chown "${owner_group}" "${FILE_PATH}" || cu.errors.die $CU_ERROR "Failed to set owner/group on file $FILE_PATH"
}

if [[ "${OPERATION}" == "get" || "${OPERATION}" == "get_without_lock" ]]; then
  get
elif [[ "${OPERATION}" == "set" || "${OPERATION}" == "set_overwrite" ]]; then
  force="false"
  [[ "${OPERATION}" == "set_overwrite" ]] && force="true"
  set "${force}" "$1"
elif [[ "${OPERATION}" == "delete" ]]; then
  delete
elif [[ "${OPERATION}" == "chmod" ]]; then
  chmod "$1"
elif [[ "${OPERATION}" == "chown" ]]; then
  chown "$1"
else
  [[ -z "${OPERATION}" ]] && cu.errors.die $CU_ERROR_USAGE "No OPERATION specified"
  cu.errors.die $CU_ERROR_USAGE "Unknown OPERATION: ${OPERATION}"
fi
