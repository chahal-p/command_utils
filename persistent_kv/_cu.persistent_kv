#!/usr/bin/env bash

function usage() {
  echo "Usage: $(basename "${0}") <subcommand> [args...]"
  echo "Subcommands:"
  echo "  list [<namespace>]"
  echo "  get <namespace> <key>"
  echo "  set <namespace> <key> [<etag>"]
  echo "  set_overwrite <namespace> <key> [<etag>]"
  echo "  delete <namespace> <key>"
  echo "  chmod <namespace> <key> <mode>"
  echo "  chown <namespace> <key> <owner_group>"
  echo "  concat <namespace> [<key_1>,<key_2>,...] [shellvar | comma_separated]"
  echo ""
  echo "In set or set_overwrite subcommand, stdin is used as the value"
}

[[ "$1" == "--help" || "$1" == "-h" ]] && { usage; exit 0; }

# In set or set_overwrite subcommand, stdin is used as the value
# etag is sha256 of existing value

source cu.errors_lib.bash
source _cu.persistent_kv.configs || cu.errors.die $CU_ERROR "Failed to load persistent_kv configs: _cu.persistent_kv.configs"
[ -n "${BACKEND_CMD}" ] || cu.errors.die $CU_ERROR "Variable \$BACKEND_CMD is not defined in configs. Please use cu.persistent_kv.configure command to reconfigure."
exec -a _cu.persistent_kv "${BACKEND_CMD}" "$@"
