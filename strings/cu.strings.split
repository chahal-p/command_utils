#!/usr/bin/env bash
usage="Usage: $(basename "${0}") <delimiter> <input_string>"
[[ "$1" == "-h" || "$1" == "--help" ]] && { echo "$usage" >&2; exit 0; }
[[ $# -ne 2 ]] && { echo "$usage" >&2; exit 1; }

delimiter="${1}"
input_string="${2}"

cu.python -c "import sys; print(' '.join([\"'\" + x.replace(\"'\", \"'\\\''\") + \"'\" for x in sys.argv[2].split(sys.argv[1])]))" "${delimiter}" "${input_string}"
