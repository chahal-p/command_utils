#!/usr/bin/env bash

set -eo pipefail

source cu.errors_lib.bash

STORAGE_DIR="$1"
subcommand="$2"
shift 2

USER="$(whoami)"

function die() {
  cu.errors.die "$@"
}

function validate_namespace() {
  local namespace="$1"
  [[ -n "${namespace}" ]] || die $CU_ERROR_USAGE "Namespace is required"
  [[ "${#namespace}" -le 64 ]] || die $CU_ERROR_USAGE "Invalid namespace: namespace should be at most 64 characters long"
  [[ "${namespace}" =~ ^[a-zA-Z0-9_-]+$ ]] || die $CU_ERROR_USAGE "Invalid namespace: namespace should match regex ^[a-zA-Z0-9_-]+$"
}

function validate_key() {
  local key="$1"
  [[ -n "${key}" ]] || die $CU_ERROR_USAGE "Key is required"
  [[ "${#key}" -ge 1 && "${#key}" -le 64 ]] || die $CU_ERROR_USAGE "Invalid key: key size should be at least 1 and at most 64 characters long"
  [[ "${key}" =~ ^[a-zA-Z0-9_.-]+$ ]] || die $CU_ERROR_USAGE "Invalid key: key should match regex ^[a-zA-Z0-9_.-]+$"
}

function list() {
  local namespace="${1}"
  local subcommand="${2}"
  local items=()
  local x

  [ -r "${STORAGE_DIR}" ] || die $CU_ERROR "Permission denied: $USER does not have permission to read storage directory '${STORAGE_DIR}'"
  if [[ -n "${namespace}" ]]; then
    validate_namespace "${namespace}"
    for x in $(ls -1F --color=never "${STORAGE_DIR}" | grep -v "\/$" | grep "^${namespace}\."); do
      [ -r "${STORAGE_DIR%/}/${x}" ] || continue
      items+=("${x#*.}")
    done
    [[ ${#items[@]} -eq 0 ]] && die $CU_ERROR_NOT_FOUND "Namespace ${namespace} not found"
    printf '%s\n' "${items[@]}" | LC_ALL=C sort -u
  else
    for x in $(ls -1F --color=never "${STORAGE_DIR}" | grep -v "\/$"); do
      [ -r "${STORAGE_DIR%/}/${x}" ] || continue
      items+=("${x%%.*}")
    done
    [[ ${#items[@]} -eq 0 ]] && exit
    printf '%s\n' "${items[@]}" | LC_ALL=C sort -u
  fi
}

function get() {
  local namespace key no_lock key_file
  namespace="${1}"
  key="${2}"
  no_lock="${3}"
  key_file="${STORAGE_DIR}/${namespace}.${key}"
  validate_namespace "${namespace}"
  validate_key "${key}"
  if [ "$no_lock" == "true" ]; then
    cu.file get_without_lock "$key_file"
  else
    exec cu.file get "$key_file"
  fi
}

function set() {
  local namespace="${1}"
  local key="${2}"
  local etag="${3}"
  local force="${4}"
  local key_file="${STORAGE_DIR}/${namespace}.${key}"
  validate_namespace "${namespace}"
  validate_key "${key}"
  if [ "$force" == "true" ]; then
    exec cu.file set_overwrite "$key_file"
  else
    exec cu.file set "$key_file"
  fi
}

function delete() {
  local namespace="${1}"
  local key="${2}"
  local key_file="${STORAGE_DIR}/${namespace}.${key}"
  validate_namespace "${namespace}"
  validate_key "${key}"
  exec cu.file delete "$key_file"
}

function chmod() {
  local namespace="${1}"
  local key="${2}"
  local mode="${3}"
  local key_file="${STORAGE_DIR}/${namespace}.${key}"
  validate_namespace "${namespace}"
  validate_key "${key}"
  exec cu.file chmod "$key_file" "$mode"
}

function chown() {
  local namespace="${1}"
  local key="${2}"
  local owner_group="${3}"
  local key_file="${STORAGE_DIR}/${namespace}.${key}"
  validate_namespace "${namespace}"
  validate_key "${key}"
  exec cu.file chown "$key_file" "$owner_group"
}

function concat() {
  # No locking is performed while reading files
  local namespace="${1}"
  local comma_separated_key="${2}"
  local format="${3}"
  local keys=()
  local key
  validate_namespace "${namespace}"
  if [[ -z "${comma_separated_key}" ]]; then
    keys=( $(list "${namespace}" "list") ) || exit
  else
    IFS=',' read -r -a keys <<< "${comma_separated_key}"
  fi
  if [[ "$format" == "values" ]]; then
    for key in "${keys[@]}"; do
      get "${namespace}" "${key}" "true" || exit
      printf "\n"
    done
  elif [[ "$format" == "shellvars" ]]; then
    for key in "${keys[@]}"; do
      printf "%s=%s;\n" "${key}" "$(cu.strings.quoted "$(get "${namespace}" "${key}" "true")")" || exit
    done
  elif [[ "$format" == "comma_separated" ]]; then
    for key in "${keys[@]}"; do
      printf "%s,%s\n" "${key}" "$(get "${namespace}" "${key}" "true")" || exit
    done
  else
    die $CU_ERROR_USAGE "Unknown format: ${format}"
  fi
}

if [[ "${subcommand}" == "list" ]]; then
  list "$1" "${subcommand}"
elif [[ "${subcommand}" == "get" ]]; then
  get "$1" "$2"
elif [[ "${subcommand}" == "set" || "${subcommand}" == "set_overwrite" ]]; then
  force="false"
  [[ "${subcommand}" == "set_overwrite" ]] && force="true"
  set "$1" "$2" "$3" "${force}"
elif [[ "${subcommand}" == "delete" ]]; then
  delete "$1" "$2"
elif [[ "${subcommand}" == "chmod" ]]; then
  chmod "$1" "$2" "$3"
elif [[ "${subcommand}" == "chown" ]]; then
  chown "$1" "$2" "$3"
elif [[ "${subcommand}" == "concat" ]]; then
  concat "$1" "$2" "$3"
else
  [[ -z "${subcommand}" ]] && die $CU_ERROR_USAGE "No subcommand specified"
  die $CU_ERROR_USAGE "Unknown subcommand: ${subcommand}"
fi
