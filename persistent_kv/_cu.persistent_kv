#!/usr/bin/env bash

function usage() {
  cat <<EOF
Usage: $(basename "${0}") <subcommand> [args...]"
Subcommands:
  list [<namespace>]
  get <namespace> <key>
  set <namespace> <key> [<etag>"]
  set_overwrite <namespace> <key> [<etag>]"
  delete <namespace> <key>
  concat <namespace> [<key_1>,<key_2>,...] [<key_value_format>]
  chmod <namespace> <key> <mode>
  chown <namespace> <key> <owner_group>

Details:
  etag              : sha256 of existing value (for new entry set it as empty string \`sha256sum < <("")\`)
  concat            : Content for each key/value pair is concatenated with an empty line in between based on key_value_format parameter.
  key_value_format  : Key and value formated before concat operation
                      Supported formats:
                        values: values of keys concatenated
                        shellvars: KEY1='<value>'
                        comma_separated: key,value
  set               : stdin is used as the value
  set_overwrite     : stdin is used as the value
  owner_group       : value format is <user>[:<group>]
EOF
}

[[ "$1" == "--help" || "$1" == "-h" ]] && { usage; exit 0; }

# In set or set_overwrite subcommand, stdin is used as the value
# etag is sha256 of existing value

source cu.errors_lib.bash
source _cu.persistent_kv.configs || cu.errors.die $CU_ERROR "Failed to load persistent_kv configs: _cu.persistent_kv.configs"
[ -n "${BACKEND_CMD}" ] || cu.errors.die $CU_ERROR "Variable \$BACKEND_CMD is not defined in configs. Please use cu.persistent_kv.configure command to reconfigure."
exec -a _cu.persistent_kv "${BACKEND_CMD[@]}" "$@"
